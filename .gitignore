# Environments and caches
.pixi/
__pycache__/
*.pyc
*.egg-info/
.ruff_cache/
.mypy_cache/
.snakemake/
.ipynb_checkpoints/

# Panel notebooks are tracked as percent-format .py; the paired .ipynb stays local.
*.ipynb

# Build outputs of each figure: local only. `pixi run promote <name>` copies the version to
# share into figures/<name>/final/, which is tracked.
# Every layout sets output_dir: output.
figures/*/output/

# Editors and agents
.vscode/
.claude/settings.local.json
.DS_Store
